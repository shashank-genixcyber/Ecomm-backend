DJANGO_SECRET_KEY=
# With no vault URL, the app uses DJANGO_SECRET_KEY and OIDC_CLIENT_SECRET below.
# With a vault URL, both values come only from Key Vault at Django startup.
AZURE_KEY_VAULT_URL=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Names under Key Vault > Objects > Secrets; the defaults match this setup.
DJANGO_SECRET_KEY_NAME=django-secret-key
OIDC_CLIENT_SECRET_NAME=oidc-client-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# OIDC discovery base URL, e.g. https://accounts.google.com
# or http://localhost:8080/realms/shop for local Keycloak.
OIDC_SERVER_URL=https://accounts.google.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_PROVIDER_NAME=Google
